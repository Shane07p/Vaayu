# Copy to .env. Never commit .env.
#
# A key that is absent or blank puts that source in FIXTURE mode: committed
# sample payloads are read and the UI badges the values CACHED. A key that is
# present puts the source in LIVE mode. A live call that fails surfaces
# SOURCE_UNAVAILABLE and never falls back to fixtures.

# Database
POSTGRES_DB=vaayu
POSTGRES_USER=vaayu
POSTGRES_PASSWORD=vaayu

# If you have PostgreSQL installed locally it already owns 5432, and host
# connections will reach it instead of the container and fail authentication.
# Set both of these to 5433 in that case. Inside Docker the port is always 5432.
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql+psycopg://vaayu:vaayu@localhost:5432/vaayu

# Ingestion keys — absent means fixture mode, present means live
DATA_GOV_IN_API_KEY=
OPENAQ_API_KEY=
FIRMS_MAP_KEY=

# AI
GEMINI_API_KEY=
# Verified working 2026-08-22. gemini-2.0-flash and gemini-2.5-flash both
# return HTTP 404 "no longer available" -- Google retires model IDs, and a stale
# one silently disables the only Google AI integration in the project.
# Check availability with:
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEY"
GEMINI_MODEL=gemini-3.6-flash

# Earth Engine service account JSON path
GEE_SERVICE_ACCOUNT_KEY=

# Console stub auth — not an identity provider, replaced before any deployment
CONSOLE_SHARED_SECRET=dev-only-not-a-real-secret

# Browser requests use this same-origin path. Cloud Run supplies INTERNAL_API_URL
# and WEB_ALLOWED_ORIGIN when deploying the web and backend services.
NEXT_PUBLIC_API_URL=/api
WEB_ALLOWED_ORIGIN=http://localhost:3000
