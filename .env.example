# Copy to .env. Never commit .env.
#
# A key that is absent or blank puts that source in FIXTURE mode: committed
# sample payloads are read and the UI badges the values CACHED. A key that is
# present puts the source in LIVE mode. A live call that fails surfaces
# SOURCE_UNAVAILABLE and never falls back to fixtures.

# Database
POSTGRES_DB=vaayu
POSTGRES_USER=vaayu
POSTGRES_PASSWORD=vaayu
DATABASE_URL=postgresql+psycopg://vaayu:vaayu@localhost:5432/vaayu

# Ingestion keys — absent means fixture mode, present means live
DATA_GOV_IN_API_KEY=
OPENAQ_API_KEY=
FIRMS_MAP_KEY=

# AI
GEMINI_API_KEY=

# Earth Engine service account JSON path
GEE_SERVICE_ACCOUNT_KEY=

# Console stub auth — not an identity provider, replaced before any deployment
CONSOLE_SHARED_SECRET=dev-only-not-a-real-secret
